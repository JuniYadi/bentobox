{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bentobox",
  "version": "0.0.1",
  "identifier": "com.juniyadi.bentobox",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BentoBox",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4REEyMTA3RTI0NUMxNzIKUldSeXdVWGlCeUhhMklvbHlMVHEyZ3FRSWg0MXFtTUJqUHM4R3pRUFZta2U5TzhrK2FoQ0dCRGwK",
      "endpoints": ["https://github.com/JuniYadi/bentobox/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
